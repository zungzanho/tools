#!/usr/bin/env bash
# RHEL NetBackup primary server preinstallation
# Launch on root
# Usage: curl -fsSL https://your-server/preinstall-nbu11.sh | bash -
# Usage: bash ./preinstall-nbu11.sh

set -Eeuo pipefail
umask 022

trap 'rc=$?; printf "\n[ALERT] NBU preinstallation failed: line=%s exit=%s command=%s\n" "$LINENO" "$rc" "$BASH_COMMAND" >&2; exit "$rc"' ERR

die() {
    printf '[ALERT] %s\n' "$*" >&2
    exit 1
}

[[ "${EUID}" -eq 0 ]] || die "Run this script as root."

[[ -r /etc/os-release ]] || die "/etc/os-release is unavailable."
source /etc/os-release
[[ "${ID:-}" == "rhel" ]] || die "This script requires RHEL."

for cmd in dnf getent useradd groupadd usermod hostname \
           sysctl getenforce setenforce sed grep cut mktemp chmod mv; do
    command -v "$cmd" >/dev/null ||
        die "Required command is unavailable: $cmd"
done

[[ -f /etc/selinux/config ]] ||
    die "/etc/selinux/config is unavailable."

printf '[INFO] Installing packages...\n'
dnf install -y \
    libnsl.so.1 libnsl libcrypt.so.1 \
    libXtst libXrender xorg-x11-xinit \
    nginx samba nfs-utils podman

# getent exit code 2 means the requested entry does not exist.
entry_exists() {
    local rc
    if getent "$1" "$2" >/dev/null; then
        return 0
    else
        rc=$?
        [[ "$rc" -eq 2 ]] && return 1
        die "getent failed for $1/$2 (exit $rc)."
    fi
}

printf '[INFO] Preparing service accounts...\n'
if ! entry_exists passwd nbsvcusr; then
    useradd -c 'NetBackup Services account' \
        -d /usr/openv/ -s /usr/sbin/nologin nbsvcusr
fi

if ! entry_exists group nbwebgrp; then
    groupadd nbwebgrp
fi

usermod -aG nbwebgrp -s /usr/sbin/nologin nbsvcusr

if ! entry_exists passwd nbwebsvc; then
    useradd -g nbwebgrp \
        -c 'NetBackup Web Services account' \
        -d /usr/openv/wmc -s /usr/sbin/nologin nbwebsvc
fi

usermod -g nbwebgrp -s /usr/sbin/nologin nbwebsvc

printf '[INFO] Configuring file limits...\n'
mkdir -p /etc/security/limits.d
cat > /etc/security/limits.d/99-nbu-preinstall.conf <<'EOF'
* soft nofile 8192
* hard nofile 8192
EOF
chmod 0644 /etc/security/limits.d/99-nbu-preinstall.conf

printf '[INFO] Configuring kernel parameters...\n'
touch /etc/sysctl.conf
sed -i \
    -e '/^[[:space:]]*kernel\.sem[[:space:]]*=/d' \
    -e '/^[[:space:]]*fs\.file-max[[:space:]]*=/d' \
    /etc/sysctl.conf

cat >> /etc/sysctl.conf <<'EOF'
kernel.sem = 300 307200 100 1024
fs.file-max = 3245530
EOF

sysctl -p /etc/sysctl.conf

printf '[INFO] Configuring SELinux...\n'
selinux_state="$(getenforce)"
case "$selinux_state" in
    Enforcing)
        setenforce 0
        ;;
    Permissive|Disabled)
        ;;
    *)
        die "Unexpected SELinux state: $selinux_state"
        ;;
esac

sed -i '/^[[:space:]]*SELINUX[[:space:]]*=/d' /etc/selinux/config
printf 'SELINUX=disabled\n' >> /etc/selinux/config

printf '[INFO] Configuring root Bash profile...\n'
root_home="$(getent passwd root | cut -d: -f6)"
[[ -n "$root_home" && -d "$root_home" ]] ||
    die "Root home directory is unavailable."

profile="${root_home}/.bash_profile"
touch "$profile"

# Replace this script's managed block on subsequent runs.
sed -i \
    '/^# BEGIN NBU PREINSTALL PATH$/,/^# END NBU PREINSTALL PATH$/d' \
    "$profile"

cat >> "$profile" <<'EOF'

# BEGIN NBU PREINSTALL PATH
NBU_BIN_PATH="/usr/openv/netbackup/bin/goodies:/usr/openv/netbackup/bin/admincmd:/usr/openv/volmgr/bin:/usr/openv/netbackup/bin:/usr/openv/db/bin:/usr/openv/netbackup/bin/support:/usr/openv/netbackup/bin/goodies/support:/opt/VRTSpbx/bin:/opt/VRTS/bin"
case ":${PATH:-}:" in
    *":${NBU_BIN_PATH}:"*) ;;
    *) PATH="${PATH:+${PATH}:}${NBU_BIN_PATH}" ;;
esac
export PATH
# END NBU PREINSTALL PATH
EOF

printf '[INFO] Creating installation answer file...\n'
fqdn="$(hostname -f)"
[[ -n "$fqdn" && "$fqdn" == *.* && "$fqdn" != *[[:space:]]* ]] ||
    die "hostname -f must return a fully qualified hostname."

answer_tmp="$(mktemp /tmp/NBInstallAnswer.conf.XXXXXX)"
chmod 0600 "$answer_tmp"

cat > "$answer_tmp" <<EOF
CLIENT_NAME = ${fqdn}
MACHINE_ROLE = PRIMARY
SERVER = ${fqdn}
INSTALL_PATH = /usr/openv
LICENSE = EVALUATION
NB_FIPS_MODE = Disable
SERVICE_USER = nbsvcusr
START_JOB_DAEMONS = yes
ALLOW_LONG_NBDB_MIGRATION_TIME = yes
IGNORE_MISSING_CATALOG_BACKUP = yes
DISASTER_RECOVERY_INSTALL = no
ACCEPT_EULA = yes
INCLUDE_JAVA_GUI_ON_PRIMARY = MATCH
PROCEED_WITH_INSTALL = yes
USE_URANDOM = ENABLE
INSTALL_ITA_DATA_COLLECTOR = no
INCLUDE_NBDIRECTIO = EXCLUDE
EOF

mv -fT "$answer_tmp" /tmp/NBInstallAnswer.conf

printf '[SUCCESS] NBU preinstallation completed.\n'
printf '[INFO] Answer file: /tmp/NBInstallAnswer.conf\n'
if [[ "$selinux_state" != "Disabled" ]]; then
    printf '[ALERT] Reboot is required to fully disable SELinux.\n' >&2
fi
